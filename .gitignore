# Raw data and large external inputs
data/
dataset/
**/*.mat
**/*.sigmf*
**/*.bin
**/*.iq
**/*.h5

# Source modules named data are code, not raw datasets.
!rf_multiview_relation/data/
!rf_multiview_relation/data/*.py

# Python environments and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local runtime logs
*.log
*.out
*.err
EXPERIMENT_LOG.md
logs/
**/logs/
run_stdout.*
run_stderr.*
**/run_stdout.*
**/run_stderr.*

# Training artifacts and large generated arrays
checkpoints/
**/checkpoints/
artifacts/
**/artifacts/
*.pth
*.pt
*.ckpt
*.npy
*.npz
*.pkl
*.joblib

# Scratch and generated build outputs
scratch/
**/scratch/
outputs/
analysis_output/
*.zip

# Local notebook and editor state
.vscode/
.idea/
*.tmp
*.bak
~$*
